# Firebase web configuration is public application metadata, not an Admin credential.
# Use a separate Firebase project for development and production.
# Full deploy checklist: docs/DEPLOYMENT.md
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_with_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_with_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=replace_with_web_app_id
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-southeast1

# Public browser token. Restrict allowed URLs in your Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_with_your_public_token

# Local: ENABLE_FIREBASE=false until configured; USE_EMULATORS=true with emulators.
# Vercel Preview/Production: ENABLE_FIREBASE=true and USE_EMULATORS=false.
NEXT_PUBLIC_ENABLE_FIREBASE=false
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_VAPID_KEY=replace_with_public_web_push_certificate_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Firebase Admin values for Vercel Route Handlers.
# Store these only in .env.local and Vercel's encrypted environment settings.
# Never prefix them with NEXT_PUBLIC_ and never commit real values.
FIREBASE_ADMIN_PROJECT_ID=replace_with_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=replace_with_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace\n-----END PRIVATE KEY-----\n"
